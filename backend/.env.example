# 이 파일을 복사해 backend/.env 를 만들고 값을 직접 입력한다. (.env는 Git에 올리지 않는다)
# 실제 키 값은 이 파일에 적지 않는다.

# OpenDART 인증키 — 기업 목록·재무제표·공시·사업보고서 (Phase 1부터 사용)
DART_API_KEY=

# NAVER API HUB(뉴스 검색) Client ID — 최근 3개월 기사 수집 (Phase 7). 예전 네이버 개발자센터 키는 쓸 수 없다
NAVER_CLIENT_ID=

# NAVER API HUB(뉴스 검색) Client Secret (Phase 7)
NAVER_CLIENT_SECRET=

# 한국은행 ECOS 인증키 — 환율·기준금리 (Phase 7)
ECOS_API_KEY=

# 공공데이터포털 인증키 — 금융위원회 주식시세정보, 주가·시가총액 (Phase 5)
DATA_GO_KR_KEY=

# AI 서비스 선택 — openai 또는 anthropic (비워 두면 openai), 개발용 fake(외부 호출 없이 고정 예시 응답) (Phase 6)
LLM_PROVIDER=openai

# OpenAI API 키 — AI 해석·추출 기본값, 부서 공유 키 (Phase 6)
OPENAI_API_KEY=

# OpenAI 모델 — 추출용은 가장 저렴한 소형 모델, 해석용은 중간급 모델 (Phase 6)
# 쓸 수 있는 모델은 `backend/.venv/bin/python check_keys.py --models` 로 확인
OPENAI_MODEL_EXTRACT=
OPENAI_MODEL_WRITE=

# Anthropic(Claude) API 키 — 선택 항목, LLM_PROVIDER=anthropic 일 때만 필요 (Phase 6)
ANTHROPIC_API_KEY=

# 실제 AI 호출 허용 — 부서 공유 키라 평소에는 비워 둔다. 1이 아니면 openai 호출은 코드에서 막힌다 (Phase 6)
LLM_ALLOW_LIVE=
